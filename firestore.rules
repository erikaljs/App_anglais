rules_version = '2';

// Règles de sécurité Firestore. Voir CLAUDE.md pour le détail des
// collections. Ces règles sont complétées à chaque étape du projet :
// pour l'instant, seules les collections des comptes et des amis
// (étape 2) sont couvertes.
service cloud.firestore {
  match /databases/{database}/documents {

    // Le profil d'un utilisateur. Tout le monde connecté peut le lire
    // (nécessaire pour afficher le pseudo d'un ami, par exemple), mais
    // seul le propriétaire peut le modifier...
    match /users/{uid} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.auth.uid == uid;
      allow delete: if false;

      // ... sauf pour la liste "amis" : accepter une demande d'ami, ou
      // retirer un ami, modifie aussi la liste de l'autre personne.
      allow update: if estConnecte() && (
        request.auth.uid == uid ||
        estAjoutAmiValide(uid) ||
        estRetraitAmiValide()
      );
    }

    // La progression d'un utilisateur dans les leçons : seulement lui.
    match /users/{uid}/progress/{id} {
      allow read, write: if estConnecte() && request.auth.uid == uid;
    }

    // Un paquet perso : son propriétaire peut tout faire. Un ami peut le
    // lire seulement s'il est visible "amis" (pas s'il est "prive").
    match /users/{uid}/decks/{deckId} {
      allow read: if estConnecte() && (
        request.auth.uid == uid ||
        (resource.data.visibilite == 'amis' && estAmiDe(uid))
      );
      allow create, update, delete: if estConnecte() && request.auth.uid == uid;
    }

    // Mes paquets suivis (liens vers des paquets d'amis) : seulement moi.
    match /users/{uid}/decksSuivis/{id} {
      allow read, write: if estConnecte() && request.auth.uid == uid;
    }

    // Une partie (Words ou Memory) : lisible et modifiable seulement
    // par les joueurs qui y participent.
    match /games/{id} {
      allow read, update: if estConnecte() && request.auth.uid in resource.data.joueurs;
      allow create: if estConnecte() && request.auth.uid in request.resource.data.joueurs;
      allow delete: if false;
    }

    // La réservation d'un pseudo : une fois pris, il ne change plus.
    match /pseudos/{pseudo} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Le code ami d'un utilisateur : une fois créé, il ne change plus.
    match /codesAmis/{code} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Une demande d'ami : lisible et modifiable seulement par les deux
    // personnes concernées (celle qui envoie et celle qui reçoit).
    match /friendRequests/{id} {
      allow read: if estConnecte() && estParticipantDemande();

      // L'identifiant du document doit être exactement "de_vers", et on ne
      // peut pas s'envoyer une demande à soi-même.
      allow create: if estConnecte() && request.resource.data.de == request.auth.uid
        && request.resource.data.vers != request.resource.data.de
        && id == request.resource.data.de + '_' + request.resource.data.vers
        && request.resource.data.statut == 'en_attente';

      // Seul le destinataire (vers) peut répondre à la demande : l'expéditeur
      // ne peut pas accepter (ni refuser) sa propre demande.
      allow update: if estConnecte() && resource.data.vers == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
        && request.resource.data.statut in ['acceptee', 'refusee'];
      allow delete: if false;
    }

    function estConnecte() {
      return request.auth != null;
    }

    function estParticipantDemande() {
      return resource.data.de == request.auth.uid || resource.data.vers == request.auth.uid;
    }

    function existeDemandeAcceptee(deUid, versUid) {
      let chemin = /databases/$(database)/documents/friendRequests/$(deUid + '_' + versUid);
      return exists(chemin) && get(chemin).data.statut == 'acceptee';
    }

    // Est-ce que [autreUid] fait partie de MES amis (lu dans mon propre
    // profil) ? Utilisé pour savoir si je peux voir les paquets "amis"
    // de quelqu'un d'autre.
    function estAmiDe(autreUid) {
      let monChemin = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(monChemin) && autreUid in get(monChemin).data.amis;
    }

    // On ajoute mon propre uid à la liste "amis" de [proprietaireUid] :
    // seul ce champ change, on ajoute exactement un élément (moi), rien
    // n'est supprimé, et une demande d'ami a bien été acceptée entre nous.
    function estAjoutAmiValide(proprietaireUid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amis']) &&
        request.resource.data.amis.hasAll(resource.data.amis) &&
        request.resource.data.amis.hasAll([request.auth.uid]) &&
        request.resource.data.amis.size() == resource.data.amis.size() + 1 &&
        existeDemandeAcceptee(proprietaireUid, request.auth.uid);
    }

    // On retire mon propre uid de la liste "amis" de quelqu'un d'autre
    // (pour mettre fin à l'amitié) : seul ce champ change, on enlève
    // exactement un élément, et c'est bien le mien. Pas besoin de
    // l'accord de l'autre personne pour arrêter d'être amis.
    function estRetraitAmiValide() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amis']) &&
        resource.data.amis.hasAll([request.auth.uid]) &&
        resource.data.amis.size() == request.resource.data.amis.size() + 1 &&
        !(request.auth.uid in request.resource.data.amis);
    }
  }
}
